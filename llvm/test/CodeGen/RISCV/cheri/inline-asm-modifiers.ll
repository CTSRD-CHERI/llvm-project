;; Tests that x for something other than a capability register is a no-op, and
;; gives the XLEN sub-register for a capability register
define dso_local i32 @modifier_x(ptr addrspace(200) %a) nounwind {
; RV32IXCHERI-LABEL: modifier_x:
; RV32IXCHERI:       # %bb.0:
; RV32IXCHERI-NEXT:    #APP
; RV32IXCHERI-NEXT:    mv a0, a0
; RV32IXCHERI-NEXT:    #NO_APP
; RV32IXCHERI-NEXT:    ret
;
; RV64IXCHERI-LABEL: modifier_x:
; RV64IXCHERI:       # %bb.0:
; RV64IXCHERI-NEXT:    #APP
; RV64IXCHERI-NEXT:    mv a0, a0
; RV64IXCHERI-NEXT:    #NO_APP
; RV64IXCHERI-NEXT:    ret
  %b = tail call i32 asm "mv ${0:x}, ${1:x}", "=r,C"(ptr addrspace(200) %a)
  ret i32 %b
}

;; Tests that y for something other than a capability register is a no-op, and
;; gives the RVY name for a capability register accepted by the assembly parser
;; (canonicalised back via the compat alias to the Xcheri form)
define dso_local ptr addrspace(200) @modifier_y(i32 %a) nounwind {
; RV32IXCHERI-LABEL: modifier_y:
; RV32IXCHERI:       # %bb.0:
; RV32IXCHERI-NEXT:    #APP
; RV32IXCHERI-NEXT:    cincoffset ca0, cnull, a0
; RV32IXCHERI-NEXT:    #NO_APP
; RV32IXCHERI-NEXT:    ret
;
; RV64IXCHERI-LABEL: modifier_y:
; RV64IXCHERI:       # %bb.0:
; RV64IXCHERI-NEXT:    #APP
; RV64IXCHERI-NEXT:    cincoffset ca0, cnull, a0
; RV64IXCHERI-NEXT:    #NO_APP
; RV64IXCHERI-NEXT:    ret
  %b = tail call ptr addrspace(200) asm "yadd ${0:y}, zero, ${1:y}", "=C,r"(i32 %a)
  ret ptr addrspace(200) %b
}

